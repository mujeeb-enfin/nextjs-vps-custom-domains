# Copy to .env and fill in. Every value is required: the app refuses to start without it.

DATABASE_URL=postgresql://ncd:change-me@localhost:5432/ncd?schema=public
REDIS_URL=redis://localhost:6379
# Used by docker-compose.yml (which builds DATABASE_URL/REDIS_URL for the containers itself).
POSTGRES_USER=ncd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ncd

# Your product name, shown in tenant-facing copy ("Sends traffic for x to <name>").
NCD_PLATFORM_NAME=Example
# Domains your platform itself serves (comma-separated). Never claimable, and the
# dashboard + private APIs are only reachable on these hosts.
NCD_PLATFORM_DOMAINS=example.com
# Hostname tenants CNAME to. Create it once in your own DNS as a DNS-only A/AAAA
# record (or an ALIAS to your load balancer). Never an IP here.
NCD_CNAME_TARGET=domains.example.com
# Public resolvers used for verification.
NCD_RESOLVERS=1.1.1.1,8.8.8.8
# Label of the ownership TXT record: <label>.<tenant hostname> = verify=<token>
NCD_TXT_LABEL=_example-verify

# Optional: append ERROR records (server + browser) to this file as well as stdout.
NCD_ERROR_LOG_FILE=logs/errors.log
