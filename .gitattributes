# Normalise text to LF in the repository.
* text=auto eol=lf

# Files executed or parsed on Linux hosts must stay LF even on Windows checkouts
# (a CRLF sudoers file is rejected by visudo; a CRLF shebang fails to run).
*.sh              text eol=lf
*.service         text eol=lf
*.conf            text eol=lf
*.tmpl            text eol=lf
Dockerfile        text eol=lf
agent/bin/*       text eol=lf
agent/sudoers/*   text eol=lf

*.png binary
*.ico binary
