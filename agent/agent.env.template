# /etc/ncd-agent/agent.env: every value is REQUIRED (the agent refuses to start otherwise).
# install.sh copies this template on first run (mode 0600, owner root); fill it in and re-run.

# The same Redis the app uses (REDIS_URL in the app's .env).
NCD_AGENT_REDIS_URL=redis://127.0.0.1:6379

# Where the Next.js app listens on this host. Loopback only.
NCD_AGENT_UPSTREAM=127.0.0.1:3000

# Must equal the app's NCD_CNAME_TARGET and NCD_PLATFORM_DOMAINS.
NCD_AGENT_CNAME_TARGET=domains.example.com
NCD_AGENT_PLATFORM_DOMAINS=example.com

# Public resolvers for the pre-issuance DNS check (same as the app's NCD_RESOLVERS).
NCD_AGENT_RESOLVERS=1.1.1.1,8.8.8.8

# Let's Encrypt account contact.
NCD_AGENT_ACME_EMAIL=
# true = Let's Encrypt staging (untrusted certs, generous limits). Switch to false once a staging domain is Active.
NCD_AGENT_ACME_STAGING=true

NCD_AGENT_VHOST_DIR=/etc/nginx/ncd-custom-domains
NCD_AGENT_ACME_WEBROOT=/var/www/ncd-acme
NCD_AGENT_TEMPLATES_DIR=/opt/ncd-agent/templates
NCD_AGENT_LOG_FILE=/var/log/ncd-agent/agent.log
